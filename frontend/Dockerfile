FROM node:22-bookworm-slim AS deps

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
# Cache bust: 2026-07-10-8
ARG CACHE_BUST_DEPS=20260715-1
RUN npm install

FROM node:22-bookworm-slim AS builder

WORKDIR /app
ARG LAB_API_BASE_URL
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG SUPABASE_URL
ARG SUPABASE_SERVICE_KEY
ARG DOUBLEWORD_API_URL
ARG DOUBLEWORD_API_KEY
ARG DOUBLEWORD_MODEL
# Path prefix when the dashboard is served under a domain sub-path
# (e.g. NEXT_PUBLIC_BASE_PATH=/broker for https://ae.propai.live/broker).
ARG NEXT_PUBLIC_BASE_PATH
ARG CACHE_BUST=20260729-1
ENV LAB_API_BASE_URL=${LAB_API_BASE_URL:-http://api:8000}
ENV NEXT_PUBLIC_SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL}
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=${NEXT_PUBLIC_SUPABASE_ANON_KEY}
ENV SUPABASE_URL=${SUPABASE_URL}
ENV SUPABASE_SERVICE_KEY=${SUPABASE_SERVICE_KEY}
ENV DOUBLEWORD_API_URL=${DOUBLEWORD_API_URL}
ENV DOUBLEWORD_API_KEY=${DOUBLEWORD_API_KEY}
ENV DOUBLEWORD_MODEL=${DOUBLEWORD_MODEL}
ENV NEXT_PUBLIC_BASE_PATH=${NEXT_PUBLIC_BASE_PATH}
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/node_modules ./node_modules
ARG CACHE_BUST_COPY=20260729-1
COPY frontend/ .

RUN npm run build

FROM node:22-bookworm-slim AS runner

WORKDIR /app
ARG LAB_API_BASE_URL
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG SUPABASE_URL
ARG SUPABASE_SERVICE_KEY
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV NEXT_TELEMETRY_DISABLED=1
ENV LAB_API_BASE_URL=${LAB_API_BASE_URL:-http://api:8000}
ENV NEXT_PUBLIC_SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL}
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=${NEXT_PUBLIC_SUPABASE_ANON_KEY}
ENV SUPABASE_URL=${SUPABASE_URL}
ENV SUPABASE_SERVICE_KEY=${SUPABASE_SERVICE_KEY}

COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next ./.next

EXPOSE 3000

CMD ["npm", "run", "start"]
